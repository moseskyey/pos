APP_NAME=DukaPOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite works out of the box for trying DukaPOS. Use MySQL 8 / MariaDB in production:
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dukapos
# DB_USERNAME=dukapos
# DB_PASSWORD=

# Multi-business: DB_DATABASE above is the central (platform) database. Each business
# gets its own database, created on sign-up with the same server and credentials.
# MySQL/MariaDB names are <prefix><id>; the DB user must be allowed to create them:
#   GRANT ALL PRIVILEGES ON `dukapos\_t%`.* TO 'dukapos'@'localhost';
TENANT_DB_PREFIX=dukapos_t
# SQLite: one file per business in this folder (default database/tenants).
# TENANT_SQLITE_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- DukaPOS integrations ---------------------------------------------------
# API keys, the FastLipa URL, SMS credentials and the business timezone are set
# (encrypted where secret) under Settings → Integrations / Localisation.
# FastLipa mobile money (STK push). Callback URL: ${APP_URL}/api/payments/callback/fastlipa
FASTLIPA_TIMEOUT=20
# Comma-separated provider IPs allowed to post callbacks (empty = allow any; every callback is still
# confirmed with FastLipa's status API)
FASTLIPA_ALLOWED_IPS=
# FastLipa can report "failed" and later "completed"; failed payments are re-checked for this long
FASTLIPA_RECHECK_FAILED_MINUTES=30
# Send our callback URL with each payment request (webhook_url)
FASTLIPA_SEND_WEBHOOK_URL=true

# Backups (spatie/laravel-backup). Disks are comma-separated, e.g. local,s3
BACKUP_NAME=dukapos          # business backups are named dukapos-<id>; the platform's own is dukapos-platform
BACKUP_DISKS=local
BACKUP_KEEP_DAYS=7
BACKUP_NOTIFY_EMAIL=
BACKUP_ARCHIVE_PASSWORD=
